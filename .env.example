# ───────────────────────────────────────────────────────────
# Tool2Slides 환경변수 예시
# 실제 값은 .env.local 에 넣으세요 (.env.local 은 git 에 커밋되지 않습니다)
# ───────────────────────────────────────────────────────────

# Gemini (멀티모달 분석). 없으면 샘플 분석으로 자동 폴백됩니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 캡처 방식: "chromium"(기본, @sparticuz/chromium) | "screenshot-api" | "mock"
CAPTURE_MODE=chromium

# (선택) 스크린샷 API 폴백을 쓸 때만. 예: Microlink 등
SCREENSHOT_API_URL=

# Firebase Admin (Firestore + Storage). 없으면 인메모리 저장소로 폴백됩니다.
# 서비스 계정 JSON 을 한 줄 문자열로 넣거나 base64 로 넣을 수 있습니다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# 또는 서비스 계정 전체 JSON (base64 인코딩)
FIREBASE_SERVICE_ACCOUNT_BASE64=
