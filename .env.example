# ───────────────────────────────────────────────────────────
# Tool2Slides 환경변수 예시
# 실제 값은 .env.local 에 넣으세요 (.env.local 은 git 에 커밋되지 않습니다)
#
# 이 앱은 DB가 없습니다. 생성한 슬라이드는 브라우저(sessionStorage)에만
# 보관되는 휘발성이며, PDF로 저장해 보관합니다. (Firebase 불필요)
# ───────────────────────────────────────────────────────────

# Gemini (멀티모달 분석 + 섹션 이미지 생성). 없으면 샘플 분석으로 폴백하고
# 섹션 이미지는 생성되지 않습니다(색상 블록으로 표시).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 섹션 일러스트 생성 모델 (선택, 기본 gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 캡처 방식: "chromium"(기본, @sparticuz/chromium) | "screenshot-api" | "mock"
CAPTURE_MODE=chromium

# (선택) 스크린샷 API 폴백을 쓸 때만. 예: Microlink 등
SCREENSHOT_API_URL=
